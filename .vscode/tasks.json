{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run main.py",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python -m main",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
            "kind": "build",
            "isDefault": true
        },
    "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true,
        "echo": true
      }
    }
  ]
}